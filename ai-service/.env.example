# AI Service Configuration
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0

# OpenAI Configuration (if using)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4

# Anthropic Configuration (if using)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database (if needed)
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_marketing

# Redis Cache (if needed)
# REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO

# CORS Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# Model Paths (for local models)
# MODEL_CACHE_DIR=./models/cache
# SENTIMENT_MODEL_PATH=./models/sentiment
# IMAGE_MODEL_PATH=./models/image_gen
